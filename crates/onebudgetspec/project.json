{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onebudgetspec",
  "projectType": "library",
  "tags": ["lang:rust", "type:binary"],
  "//": "The CLI binary over onebudgetspec-core. `build` produces target/debug/onebudgetspec, which every target that spawns it depends on; its own `test` runs the conformance suite under conformance/.",
  "implicitDependencies": ["onebudgetspec-core", "conformance"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onebudgetspec"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p onebudgetspec -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --quiet -p onebudgetspec --all-targets --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --quiet -p onebudgetspec --all-targets --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --quiet -p onebudgetspec --locked"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --quiet -p onebudgetspec --locked"
      }
    }
  }
}

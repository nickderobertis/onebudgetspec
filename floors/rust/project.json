{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rust-coverage",
  "projectType": "library",
  "tags": ["type:workspace"],
  "//": "The Rust line floor: one report over every crate's instrumented test run, held to 95%. It depends on those test targets, and on nothing else, so only a change that reaches a crate runs them.",
  "implicitDependencies": [
    "onebudgetspec-core",
    "onebudgetspec",
    "onebudgetspec-e2e",
    "onebudgetspec-conformance"
  ],
  "targets": {
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/rust-coverage.sh --report"
      },
      "dependsOn": [
        {
          "projects": [
            "onebudgetspec-core",
            "onebudgetspec",
            "onebudgetspec-e2e",
            "onebudgetspec-conformance"
          ],
          "target": "test"
        }
      ],
      "cache": false
    }
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-python",
  "projectType": "library",
  "tags": ["lang:python", "type:sdk"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "python"]
  },
  "//": "The Python SDK: report models generated from the binary's `onebudgetspec schema` by generate.py, whose `--check` runs under lint, and a client that runs the binary. Its tests run every conformance case through the SDK against the cargo-built binary, so it depends on that binary and on the cases.",
  "implicitDependencies": ["onebudgetspec", "conformance"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-sync ruff format --quiet .",
        "cwd": "sdks/python"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-sync ruff format --quiet --check .",
        "cwd": "sdks/python"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --frozen --no-sync ruff check --quiet .",
          "uv run --frozen --no-sync python generate.py --check"
        ],
        "cwd": "sdks/python",
        "parallel": false
      },
      "dependsOn": ["onebudgetspec:build"]
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-sync python generate.py",
        "cwd": "sdks/python"
      },
      "dependsOn": ["onebudgetspec:build"],
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen --no-sync ty check --quiet --error-on-warning",
        "cwd": "sdks/python"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/python-coverage.sh sdks/python --cov=onebudgetspec_sdk"
      },
      "outputs": ["{workspaceRoot}/target/python-coverage"],
      "cache": false,
      "dependsOn": ["onebudgetspec:build", "workspace:coverage-clear"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/build-dist.sh sdk-python dist/sdk-python"
      }
    }
  }
}

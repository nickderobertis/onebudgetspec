{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-typescript",
  "projectType": "library",
  "tags": ["lang:typescript", "type:sdk"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run --silent build",
        "cwd": "sdks/typescript"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write sdks/typescript"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format sdks/typescript"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings sdks/typescript"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit -p sdks/typescript/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage",
        "cwd": "sdks/typescript"
      }
    }
  }
}

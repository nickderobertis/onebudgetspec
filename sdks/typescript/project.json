{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-typescript",
  "projectType": "library",
  "tags": ["lang:typescript", "type:sdk"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "js"]
  },
  "//": "The TypeScript SDK: report types and runtime schemas generated from the binary's `onebudgetspec schema` by scripts/generate.ts, whose `--check` runs under lint, and a client that runs the binary. Its tests run every conformance case through the SDK against the cargo-built binary, so it depends on that binary and on the cases.",
  "implicitDependencies": ["onebudgetspec", "conformance"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run --silent build",
        "cwd": "sdks/typescript"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write sdks/typescript"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format sdks/typescript"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun run biome lint --error-on-warnings sdks/typescript",
          "bun run --cwd sdks/typescript generate:check"
        ],
        "parallel": false
      },
      "dependsOn": ["onebudgetspec:build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit -p sdks/typescript/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage",
        "cwd": "sdks/typescript"
      },
      "dependsOn": ["onebudgetspec:build"]
    }
  }
}

{
  "name": "@onebudgetspec/sdk",
  "version": "0.2.2",
  "description": "The onebudgetspec TypeScript SDK: check, validate and list budgets through the onebudgetspec binary, with report types generated from its schema.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickderobertis/onebudgetspec.git",
    "directory": "sdks/typescript"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check"
  },
  "optionalDependencies": {
    "@onebudgetspec/cli": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0"
  }
}

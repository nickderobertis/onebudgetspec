{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "npm-cli",
  "projectType": "library",
  "tags": ["lang:javascript", "type:distribution"],
  "//": "The @onebudgetspec/cli launcher. Published, not a workspace member: npm resolves its carriers from the registry. Its decisions are unit-tested here; onebudgetspec-packaging-e2e installs and drives the packed launcher.",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/build-dist.sh npm-launcher dist/npm"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format --write npm/cli"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome format npm/cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run biome lint --error-on-warnings npm/cli"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage",
        "cwd": "npm/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit -p npm/cli/tsconfig.json"
      }
    }
  }
}
